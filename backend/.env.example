# Database
DATABASE_URL=postgresql://postgres:Hakkim%402006@127.0.0.1:5432/ai_career_mentor
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ai_career_mentor

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI - Grok
GROK_API_KEY=your-grok-api-key
GROK_MODEL=grok-2-1212

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,docx

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
DEBUG=True
ENVIRONMENT=development

# Email (future)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ML Model Path
ML_MODEL_PATH=./app/ml/model.joblib
DATASET_PATH=./app/ml/dataset.csv

# Rate Limiting
RATE_LIMIT_AI_TUTOR=10  # requests per minute
RATE_LIMIT_RESUME=5     # requests per hour
RATE_LIMIT_INTERVIEW=3  # requests per session